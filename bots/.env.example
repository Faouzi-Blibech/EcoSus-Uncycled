# Example only: copy these lines into an env file kept OUTSIDE the repo and pass it to the game
# server (for example `docker run --env-file <path>`). Never commit real values.
#
# Cloudflare Workers AI, used only by the game server for the bot meeting brain (decision model).
# Token permission: Workers AI. Leave empty to run bots on the offline rule path.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
