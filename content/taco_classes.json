    "glass_bottle":      {"taco": ["Glass bottle"],
                          "stream": "GLASS", "item": "Clear, green, and brown glass beverage bottles", "kind": "streak", "detail": "Bouteille en verre", "trust": false},
    "glass_jar":         {"taco": ["Glass jar"],
                          "stream": "GLASS", "item": "Glass food jars", "kind": "streak", "detail": "Bocal en verre"},
    "drink_can":         {"taco": ["Drink can"],
                          "stream": "METALS", "item": "Aluminum drink cans", "kind": "streak", "detail": "Canette en aluminium"},
    "metal_can":         {"taco": ["Food Can", "Aerosol"],
