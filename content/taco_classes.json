    "plastic_container": {"taco": ["Spread tub", "Tupperware", "Disposable food container", "Other plastic container", "Plastic lid"],
                          "stream": "PLASTICS", "item": "Plastic bottles, jugs, and tubs (#1 PET, #2 HDPE, #5 PP)", "kind": "streak", "detail": "Barquette / pot plastique"},
    "plastic_film":      {"taco": ["Plastic film", "Garbage bag", "Single-use carrier bag", "Polypropylene bag"],
                          "stream": "PLASTICS", "item": "Plastic bags and shrink wrap", "kind": "streak", "detail": "Film / sac plastique"},
    "wrapper":           {"taco": ["Crisp packet", "Other plastic wrapper"],
